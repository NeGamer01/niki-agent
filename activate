#!/usr/bin/env bash
# ============================================================================
# venv-style activation of the Niki dev environment for an interactive shell.
#
#   source ./activate       (bash / zsh, repo root)
#   source ./activate.fish  (fish)
#   .\activate.ps1          (PowerShell)
#
# Applies the composed pm env (PATH + tool vars) to the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `niki` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Scripts and other processes do not source this: they run under
# `scripts/run-in-niki-env`. Both build on scripts/_activation.sh.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `niki pm
# install` and `niki update` keep that check.
# ============================================================================
_NIKI_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_niki_test_env="--test-environment"
_niki_expect_extras=""
for _niki_arg in "$@"; do
    if [ -n "$_niki_expect_extras" ]; then
        _niki_test_env="--test-environment=$_niki_arg"
        _niki_expect_extras=""
        continue
    fi
    case "$_niki_arg" in
        --) break ;;
        --test-extras) _niki_expect_extras=1 ;;
        --test-extras=*) _niki_test_env="--test-environment=${_niki_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_niki_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _niki_arg _niki_test_env _niki_expect_extras
    return 2 2>/dev/null || exit 2
fi
unset _niki_arg _niki_expect_extras

# shellcheck source=scripts/_activation.sh
. "$_NIKI_REPO/scripts/_activation.sh"

if ! niki_sync "$_NIKI_REPO" "$_niki_test_env"; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _niki_test_env
    return 1 2>/dev/null || exit 1
fi
unset _niki_test_env

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __NIKI_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

_niki_script="$(niki_compose_env "$_NIKI_REPO" sh)" || {
    echo "activate: could not compose the environment (see above)" >&2
    unset _niki_script
    return 1 2>/dev/null || exit 1
}
_niki_keys="$(printf '%s\n' "$_niki_script" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')"

# --- snapshot what we are about to change (deactivate restores this) ---
# __NIKI_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__NIKI_SAVED_PATH="$PATH"
for _niki_k in $_niki_keys; do
    eval "__NIKI_SAVED_$_niki_k=\"\${$_niki_k+set}\""
    eval "__NIKI_PRIOR_$_niki_k=\${$_niki_k-__NIKI_UNSET__}"
done
niki_apply_env "$_niki_script"

# This checkout, not whichever `niki` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__NIKI_WORKTREE="$_NIKI_REPO"
# The branch names the worktree. A checkout cannot share a branch with another.
__NIKI_WORKTREE_NAME="$(git -C "$_NIKI_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__NIKI_WORKTREE_NAME" ] || [ "$__NIKI_WORKTREE_NAME" = HEAD ]; then
    __NIKI_WORKTREE_NAME="$(basename "$_NIKI_REPO")"
fi
__NIKI_SAVED_PS1="${PS1-__NIKI_UNSET__}"
__NIKI_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__NIKI_UNSET__}"

_niki_worktree_here() {
    _niki_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_niki_top" && pwd -P)" = "$(cd "$__NIKI_WORKTREE" && pwd -P)" ]
}

niki() {
    _niki_worktree_here || {
        printf '%s\n' "niki: $(pwd) is outside $__NIKI_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__NIKI_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" niki "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe niki "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python niki "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe niki "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python niki "$@"
        else
            exec python niki "$@"
        fi
    )
}

_niki_prompt() {
    if [ "$__NIKI_SAVED_PS1" = "__NIKI_UNSET__" ]; then
        _niki_base_ps1=""
    else
        _niki_base_ps1="$__NIKI_SAVED_PS1"
    fi
    if _niki_worktree_here; then
        PS1="($__NIKI_WORKTREE_NAME) $_niki_base_ps1"
    else
        PS1="$_niki_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_niki_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_niki_prompt
fi
_niki_prompt

deactivate() {
    export PATH="$__NIKI_SAVED_PATH"
    for _niki_k in $__NIKI_KEY_LIST; do
        eval "_niki_was=\"\$__NIKI_SAVED_$_niki_k\""
        eval "_niki_old=\"\$__NIKI_PRIOR_$_niki_k\""
        if [ "$_niki_was" != "set" ]; then
            unset "$_niki_k"
        else
            export "$_niki_k=$_niki_old"
        fi
        unset "__NIKI_SAVED_$_niki_k" "__NIKI_PRIOR_$_niki_k"
    done
    if [ "$__NIKI_SAVED_PS1" = "__NIKI_UNSET__" ]; then
        unset PS1
    else
        PS1="$__NIKI_SAVED_PS1"
    fi
    if [ "$__NIKI_SAVED_PROMPT_COMMAND" = "__NIKI_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__NIKI_SAVED_PROMPT_COMMAND"
    fi
    unset __NIKI_SAVED_PATH __NIKI_KEY_LIST __NIKI_ACTIVATED \
          __NIKI_WORKTREE __NIKI_WORKTREE_NAME \
          __NIKI_SAVED_PS1 __NIKI_SAVED_PROMPT_COMMAND
    unset -f deactivate niki _niki_worktree_here _niki_prompt
    unset _niki_k _niki_was _niki_old _niki_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__NIKI_KEY_LIST="$_niki_keys"

# The composition library is not part of the user's shell.
unset -f niki_sync niki_bootstrap_python niki_compose_env niki_apply_env \
         niki_activation_current niki_ensure_env
unset _NIKI_REPO _niki_script _niki_keys _niki_k _niki_top
